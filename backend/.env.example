# =============================================================================
# CodeBlaze Backend Environment Variables (Template)
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to Git!
# =============================================================================

# Server Port
PORT=4000

# MongoDB Atlas Connection URI
DB_CONNECT_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# JWT Authentication Secret (generate a strong random string)
JWT_KEY=your_jwt_secret_key_here

# Redis Cloud / Upstash Connection URI
REDIS_CONNECTION=redis://default:<password>@<host>:<port>

# Google Gemini API Key
GEMINI_KEY=your_gemini_api_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backend URL (used for CORS / frontend config)
VITE_BACKEND_URL=http://localhost:4000
